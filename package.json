{
  "name": "dsh-turn-cost",
  "version": "0.1.2",
  "description": "Per-turn estimated cost (CNY, official DeepSeek peak/off-peak rates) shown under each assistant reply in the dsh web UI",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "token",
    "cost",
    "pricing",
    "billing",
    "cny",
    "usage"
  ],
  "license": "MIT",
  "author": "Dong CHEN",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WFMinerva/dsh-turn-cost.git"
  },
  "homepage": "https://github.com/WFMinerva/dsh-turn-cost#readme",
  "bugs": {
    "url": "https://github.com/WFMinerva/dsh-turn-cost/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
