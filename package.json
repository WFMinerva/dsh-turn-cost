{
  "name": "dsh-turn-cost",
  "version": "0.6.2",
  "description": "Per-turn/session estimated cost plus subscription quota windows for DeepSeek Harness (dsh), shown in the Web UI: pay-as-you-go DeepSeek routes show money, Kimi/Aliyun subscription routes show tokens plus the official live window reading",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "rates.example.json",
    "README.md",
    "assets"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/fold.js && node --check lib/quota.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-typert-protocol": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "semver": "7.8.5"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "token",
    "cost",
    "pricing",
    "billing",
    "cny",
    "usage"
  ],
  "license": "MIT",
  "author": "Dong CHEN",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WFMinerva/dsh-turn-cost.git"
  },
  "homepage": "https://github.com/WFMinerva/dsh-turn-cost#readme",
  "bugs": {
    "url": "https://github.com/WFMinerva/dsh-turn-cost/issues"
  }
}
